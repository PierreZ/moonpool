---
// A technique page (#414 (website makeover)): the problem, the technique, the
// live run, the code, then the Guide chapters that hold the detail. The
// chapters are named by their file in book/src/; a file that SUMMARY.md does
// not list fails the build.
import Doc from "./Doc.astro";
import { url } from "../nav";
import { chapters, pathOf } from "../lib/book.mjs";

interface Props {
  title: string;
  description: string;
  /** The book files of the Guide chapters, as SUMMARY.md names them. */
  guide: string[];
}
const { title, description, guide } = Astro.props;
const all = chapters();
const links = guide.map((file) => {
  const c = all.find((x) => x.file === file);
  if (!c) throw new Error(`${title}: ${file} is not a chapter of SUMMARY.md`);
  return { title: c.title, href: url(pathOf(file)) };
});
---
<Doc title={title} description={description} kicker="techniques" section="techniques/">
  <slot />
  <h2>In the Guide</h2>
  <ul>
    {links.map((l) => <li><a href={l.href}>{l.title}</a></li>)}
  </ul>
  <p><a href={url("techniques/")}>All the techniques</a></p>
</Doc>
